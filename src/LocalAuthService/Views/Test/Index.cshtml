<!DOCTYPE html>
<html>
<head>
    <title>OAuth2 Test Client</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
            background: #0f1117;
            color: #e1e4e8;
            min-height: 100vh;
            padding: 32px 16px;
        }
        .page-header {
            text-align: center;
            margin-bottom: 40px;
        }
        .page-header h1 { font-size: 28px; color: #fff; margin-bottom: 8px; }
        .page-header p { color: #8b949e; font-size: 15px; }
        .badge {
            display: inline-block;
            background: #21262d;
            border: 1px solid #30363d;
            border-radius: 20px;
            padding: 4px 12px;
            font-size: 12px;
            color: #8b949e;
            margin-top: 8px;
        }

        /* Scenari */
        .scenario { background: #161b22; border: 1px solid #30363d; border-radius: 12px; margin-bottom: 28px; overflow: hidden; }
        .scenario-header {
            padding: 20px 24px;
            border-bottom: 1px solid #30363d;
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .scenario-num {
            width: 36px; height: 36px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 15px; flex-shrink: 0;
        }
        .s1 .scenario-num { background: #1f4d8a; color: #58a6ff; }
        .s2 .scenario-num { background: #3d2b00; color: #e3b341; }
        .s3 .scenario-num { background: #1a3d1a; color: #56d364; }
        .scenario-title { font-size: 17px; font-weight: 600; color: #fff; }
        .scenario-subtitle { font-size: 13px; color: #8b949e; margin-top: 2px; }
        .scenario-body { padding: 24px; }

        /* Flow steps */
        .flow {
            display: flex;
            align-items: center;
            gap: 0;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 4px;
        }
        .step {
            display: flex;
            align-items: center;
            gap: 6px;
            background: #21262d;
            border: 1px solid #30363d;
            border-radius: 6px;
            padding: 7px 12px;
            font-size: 12px;
            color: #8b949e;
            transition: all 0.3s;
        }
        .step .dot {
            width: 8px; height: 8px;
            border-radius: 50%;
            background: #30363d;
            flex-shrink: 0;
        }
        .step.active { border-color: #388bfd; color: #58a6ff; background: #0d1f3c; }
        .step.active .dot { background: #58a6ff; box-shadow: 0 0 6px #58a6ff; }
        .step.done { border-color: #238636; color: #56d364; background: #0d2818; }
        .step.done .dot { background: #56d364; }
        .arrow { color: #30363d; font-size: 16px; padding: 0 2px; flex-shrink: 0; }

        /* Form */
        .form-row { display: flex; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
        .form-group { display: flex; flex-direction: column; gap: 5px; flex: 1; min-width: 160px; }
        .form-group label { font-size: 12px; color: #8b949e; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px; }
        .form-group input {
            background: #21262d;
            border: 1px solid #30363d;
            border-radius: 6px;
            padding: 9px 12px;
            color: #e1e4e8;
            font-size: 14px;
        }
        .form-group input:focus { border-color: #388bfd; outline: none; }
        .form-group select { width: 100%; padding: 8px 10px; background: #0d1117; border: 1px solid #30363d; border-radius: 6px; color: #e1e4e8; font-size: 13px; }
        .form-group.full { flex: 100%; min-width: 100%; }

        /* Config box */
        .config-box {
            background: #21262d;
            border: 1px solid #30363d;
            border-radius: 8px;
            padding: 14px 16px;
            margin-bottom: 16px;
            font-size: 13px;
        }
        .config-box .config-title { color: #8b949e; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; }
        .config-item { display: flex; gap: 8px; margin-bottom: 5px; }
        .config-key { color: #8b949e; min-width: 100px; flex-shrink: 0; }
        .config-val { color: #e1e4e8; font-family: monospace; word-break: break-all; }
        .config-val.highlight { color: #e3b341; }

        /* Buttons */
        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s;
            text-decoration: none;
            display: inline-block;
        }
        .btn-blue { background: #1f6feb; color: #fff; }
        .btn-blue:hover { background: #388bfd; }
        .btn-yellow { background: #9e6a03; color: #fff; }
        .btn-yellow:hover { background: #b07b03; }
        .btn-green { background: #238636; color: #fff; }
        .btn-green:hover { background: #2ea043; }
        .btn:disabled { opacity: 0.5; cursor: not-allowed; }

        /* Response */
        .response-area { margin-top: 20px; display: none; }
        .response-area.visible { display: block; }
        .response-tabs { display: flex; gap: 2px; margin-bottom: 0; }
        .tab-btn {
            padding: 6px 14px;
            background: #21262d;
            border: 1px solid #30363d;
            border-bottom: none;
            border-radius: 6px 6px 0 0;
            font-size: 12px;
            cursor: pointer;
            color: #8b949e;
        }
        .tab-btn.active { background: #0d1f3c; color: #58a6ff; border-color: #388bfd; }
        .tab-content {
            background: #0d1117;
            border: 1px solid #30363d;
            border-radius: 0 6px 6px 6px;
            padding: 16px;
            font-family: monospace;
            font-size: 13px;
            white-space: pre-wrap;
            word-break: break-all;
            max-height: 320px;
            overflow-y: auto;
            color: #e1e4e8;
        }
        .tab-panel { display: none; }
        .tab-panel.active { display: block; }

        .status-badge {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
            margin-left: 8px;
        }
        .status-ok { background: #0d2818; color: #56d364; border: 1px solid #238636; }
        .status-err { background: #3d0e0e; color: #f85149; border: 1px solid #da3633; }

        .loading { color: #8b949e; font-size: 13px; margin-top: 8px; display: none; }
        .loading.visible { display: block; }

        /* Mode badge */
        .mode-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 5px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            margin-top: 12px;
            border: 1px solid;
            transition: all 0.4s;
        }
        .mode-badge .mode-dot {
            width: 9px; height: 9px;
            border-radius: 50%;
        }
        .mode-badge.offline {
            background: #1a1a2e;
            border-color: #58a6ff;
            color: #58a6ff;
        }
        .mode-badge.offline .mode-dot {
            background: #58a6ff;
            box-shadow: 0 0 6px #58a6ff;
            animation: pulse-blue 2s infinite;
        }
        .mode-badge.online {
            background: #0d2818;
            border-color: #56d364;
            color: #56d364;
        }
        .mode-badge.online .mode-dot {
            background: #56d364;
            box-shadow: 0 0 6px #56d364;
        }
        .mode-badge.checking {
            background: #21262d;
            border-color: #8b949e;
            color: #8b949e;
        }
        .mode-badge.checking .mode-dot {
            background: #8b949e;
            animation: pulse-grey 1s infinite;
        }
        @@keyframes pulse-blue {
            0%, 100% { opacity: 1; } 50% { opacity: 0.4; }
        }
        @@keyframes pulse-grey {
            0%, 100% { opacity: 1; } 50% { opacity: 0.3; }
        }

        /* JWT claims */
        .claims-table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .claims-table th { text-align: left; padding: 6px 10px; color: #8b949e; border-bottom: 1px solid #21262d; font-weight: 500; }
        .claims-table td { padding: 6px 10px; border-bottom: 1px solid #161b22; vertical-align: top; }
        .claims-table td:first-child { color: #58a6ff; font-family: monospace; white-space: nowrap; }
        .claims-table td:last-child { color: #e1e4e8; font-family: monospace; word-break: break-all; }
        .token-exp { font-size: 12px; color: #8b949e; margin-top: 10px; padding-top: 10px; border-top: 1px solid #21262d; }
        .exp-ok { color: #56d364; }
        .exp-warn { color: #e3b341; }

        .separator { height: 1px; background: #21262d; margin: 20px 0; }

        /* API call section */
        .api-call-box { padding: 4px 0; }
        .api-url {
            display: inline-flex; align-items: center; gap: 8px;
            background: #21262d; border: 1px solid #30363d;
            border-radius: 6px; padding: 8px 14px;
            font-family: monospace; font-size: 13px; color: #8b949e;
            margin-bottom: 14px;
        }
        .api-url .method { color: #56d364; font-weight: 700; }
        .api-url .path { color: #58a6ff; }
        .api-url .auth-badge {
            background: #0d1f3c; color: #58a6ff;
            border: 1px solid #388bfd; border-radius: 4px;
            padding: 2px 7px; font-size: 11px;
        }
        .api-result { margin-top: 12px; }
        .api-result-header {
            display: flex; align-items: center; gap: 10px;
            margin-bottom: 8px; font-size: 13px;
        }
        .http-status {
            padding: 3px 10px; border-radius: 4px;
            font-size: 12px; font-weight: 700;
        }
        .http-200 { background: #0d2818; color: #56d364; border: 1px solid #238636; }
        .http-401 { background: #3d0e0e; color: #f85149; border: 1px solid #da3633; }
    </style>
</head>
<body>

<div class="page-header">
    <h1>🧪 OAuth2 Test Client</h1>
    <p>Playground per testare i 3 scenari di autenticazione</p>
    <span class="badge">LocalAuthService · @ViewBag.BaseUrl</span>
    <br/>
    <span class="mode-badge checking" id="mode-badge">
        <span class="mode-dot"></span>
        <span id="mode-label">Verifica modalità...</span>
    </span>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- SCENARIO 1: PASSWORD GRANT                                  -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div class="scenario s1">
    <div class="scenario-header">
        <div class="scenario-num">1</div>
        <div>
            <div class="scenario-title">Password Grant</div>
            <div class="scenario-subtitle">Operatore HMI — login diretto con username e password</div>
        </div>
    </div>
    <div class="scenario-body">

        <div class="flow" id="flow1">
            <div class="step active" id="s1-step1"><div class="dot"></div>Credenziali</div>
            <div class="arrow">›</div>
            <div class="step" id="s1-step2"><div class="dot"></div>POST /connect/token</div>
            <div class="arrow">›</div>
            <div class="step" id="s1-step3"><div class="dot"></div>access_token</div>
            <div class="arrow">›</div>
            <div class="step" id="s1-step4"><div class="dot"></div>refresh_token</div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Client</label>
                <select id="s1-client"></select>
            </div>
            <div class="form-group">
                <label>Username</label>
                <input id="s1-username" type="text" value="" />
            </div>
            <div class="form-group">
                <label>Password</label>
                <input id="s1-password" type="text" value="" />
            </div>
            <div class="form-group full">
                <label>Scope</label>
                <input id="s1-scope" type="text" value="openid profile email offline_access" />
            </div>
        </div>

        <button class="btn btn-blue" onclick="runScenario1()">▶ Esegui Password Grant</button>
        <div class="loading" id="s1-loading">⏳ Chiamata in corso...</div>

        <div class="response-area" id="s1-response">
            <div class="response-tabs">
                <button class="tab-btn active" onclick="switchTab('s1','raw')">JSON risposta</button>
                <button class="tab-btn" onclick="switchTab('s1','access')">Access Token</button>
                <button class="tab-btn" onclick="switchTab('s1','refresh')">Refresh Token</button>
                <button class="tab-btn" onclick="switchTab('s1','api')">🔒 Chiama API</button>
            </div>
            <div class="tab-content">
                <div class="tab-panel active" id="s1-tab-raw"></div>
                <div class="tab-panel" id="s1-tab-access"></div>
                <div class="tab-panel" id="s1-tab-refresh"></div>
                <div class="tab-panel" id="s1-tab-api"><div id="s1-api-content"></div></div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- SCENARIO 2: AUTHORIZATION CODE                              -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div class="scenario s2">
    <div class="scenario-header">
        <div class="scenario-num">2</div>
        <div>
            <div class="scenario-title">Authorization Code + Consent</div>
            <div class="scenario-subtitle">MES Fornitore — accesso con login utente e schermata di consenso</div>
        </div>
    </div>
    <div class="scenario-body">

        <div class="flow">
            <div class="step active"><div class="dot"></div>Authorize</div>
            <div class="arrow">›</div>
            <div class="step"><div class="dot"></div>Login</div>
            <div class="arrow">›</div>
            <div class="step"><div class="dot"></div>Consent</div>
            <div class="arrow">›</div>
            <div class="step"><div class="dot"></div>Code → Callback</div>
            <div class="arrow">›</div>
            <div class="step"><div class="dot"></div>Token</div>
        </div>

        <div class="config-box">
            <div class="config-title">Configurazione client</div>
            <div class="config-item">
                <span class="config-key">client_id</span>
                <select id="s2-client" style="background:#0d1117;border:1px solid #30363d;border-radius:4px;color:#e1e4e8;padding:2px 6px;"></select>
            </div>
            <div class="config-item">
                <span class="config-key">client_secret</span>
                <input id="s2-secret" type="text" placeholder="(opzionale)" style="background:#0d1117;border:1px solid #30363d;border-radius:4px;color:#e1e4e8;padding:2px 6px;width:200px;" />
            </div>
            <div class="config-item"><span class="config-key">redirect_uri</span><span class="config-val highlight">@ViewBag.BaseUrl/test/callback</span></div>
            <div class="config-item"><span class="config-key">scope</span><span class="config-val">openid profile email offline_access</span></div>
        </div>

        <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
            <button class="btn btn-yellow" onclick="startScenario2()">▶ Avvia Authorization Code Flow</button>
            <form method="post" action="/test/revoke-consent" style="margin:0">
                @Html.AntiForgeryToken()
                <input type="hidden" id="s2-revoke-client" name="clientId" value="" />
                <button type="submit" class="btn" style="background:#21262d; border:1px solid #f85149; color:#f85149; font-size:13px; padding:9px 16px;"
                        onclick="document.getElementById('s2-revoke-client').value=document.getElementById('s2-client').value; return confirm('Revocare il consent salvato?')">
                    🗑 Revoca consent
                </button>
            </form>
        </div>
        <p style="margin-top:10px; font-size:13px; color:#8b949e;">
            Il browser verrà reindirizzato alla login page (solo se il cookie è scaduto), poi al consent screen (solo al primo accesso o dopo revoca), poi tornerà qui con il risultato.
        </p>

        <div class="separator"></div>

        <!-- Pannello refresh token -->
        <div id="s2-refresh-panel" style="display:none">
            <div style="font-size:12px; color:#8b949e; text-transform:uppercase; letter-spacing:.5px; margin-bottom:12px;">Refresh Token Disponibile</div>
            <div class="config-box" style="margin-bottom:14px">
                <div class="config-item">
                    <span class="config-key">stato</span>
                    <span class="config-val" style="color:#56d364">✅ Salvato in localStorage</span>
                </div>
                <div class="config-item">
                    <span class="config-key">token</span>
                    <span class="config-val highlight" id="s2-rt-preview" style="font-size:11px; word-break:break-all"></span>
                </div>
            </div>
            <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-bottom:8px">
                <button class="btn btn-yellow" onclick="runRefresh()">🔄 Rinnova Access Token</button>
                <button class="btn" style="background:#21262d; border:1px solid #30363d; color:#8b949e; font-size:13px; padding:9px 16px"
                        onclick="clearRefreshToken()">🗑 Cancella token salvato</button>
            </div>
            <div class="loading" id="s2-loading">⏳ Rinnovo in corso...</div>
            <div class="response-area" id="s2-response">
                <div class="response-tabs">
                    <button class="tab-btn active" onclick="switchTab('s2','raw')">JSON risposta</button>
                    <button class="tab-btn" onclick="switchTab('s2','access')">Access Token</button>
                    <button class="tab-btn" onclick="switchTab('s2','api')">🔒 Chiama API</button>
                </div>
                <div class="tab-content">
                    <div class="tab-panel active" id="s2-tab-raw"></div>
                    <div class="tab-panel" id="s2-tab-access"></div>
                    <div class="tab-panel" id="s2-tab-api"><div id="s2-api-content"></div></div>
                </div>
            </div>
        </div>

        <div id="s2-no-token-msg" style="font-size:13px; color:#8b949e; display:none; margin-top:4px">
            Nessun refresh token salvato. Avvia il flow per ottenerne uno.
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- SCENARIO 3: CLIENT CREDENTIALS                              -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div class="scenario s3">
    <div class="scenario-header">
        <div class="scenario-num">3</div>
        <div>
            <div class="scenario-title">Client Credentials (M2M)</div>
            <div class="scenario-subtitle">Office API — accesso macchina-a-macchina senza utente</div>
        </div>
    </div>
    <div class="scenario-body">

        <div class="flow" id="flow3">
            <div class="step active" id="s3-step1"><div class="dot"></div>client_id + secret</div>
            <div class="arrow">›</div>
            <div class="step" id="s3-step2"><div class="dot"></div>POST /connect/token</div>
            <div class="arrow">›</div>
            <div class="step" id="s3-step3"><div class="dot"></div>access_token</div>
        </div>

        <div class="config-box">
            <div class="config-title">Configurazione client</div>
            <div class="config-item">
                <span class="config-key">client_id</span>
                <select id="s3-client" style="background:#0d1117;border:1px solid #30363d;border-radius:4px;color:#e1e4e8;padding:2px 6px;"></select>
            </div>
            <div class="config-item">
                <span class="config-key">client_secret</span>
                <input id="s3-secret" type="text" placeholder="client secret" style="background:#0d1117;border:1px solid #30363d;border-radius:4px;color:#e1e4e8;padding:2px 6px;width:200px;" />
            </div>
            <div class="config-item">
                <span class="config-key">scope</span>
                <input id="s3-scope" type="text" value="openid" style="background:#0d1117;border:1px solid #30363d;border-radius:4px;color:#e1e4e8;padding:2px 6px;width:200px;" />
            </div>
        </div>

        <button class="btn btn-green" onclick="runScenario3()">▶ Esegui Client Credentials</button>
        <div class="loading" id="s3-loading">⏳ Chiamata in corso...</div>

        <div class="response-area" id="s3-response">
            <div class="response-tabs">
                <button class="tab-btn active" onclick="switchTab('s3','raw')">JSON risposta</button>
                <button class="tab-btn" onclick="switchTab('s3','access')">Access Token</button>
                <button class="tab-btn" onclick="switchTab('s3','api')">🔒 Chiama API</button>
            </div>
            <div class="tab-content">
                <div class="tab-panel active" id="s3-tab-raw"></div>
                <div class="tab-panel" id="s3-tab-access"></div>
                <div class="tab-panel" id="s3-tab-api"><div id="s3-api-content"></div></div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- SCENARIO 4: LEGACY CREDENTIALS                              -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div class="scenario s4" style="--s4-color: #8b5a00;">
    <style>
        .scenario.s4 .scenario-num { background: #3d2b00; color: #e3b341; }
        .s4 .scenario-num { background: #3d2b00; color: #e3b341; }
    </style>
    <div class="scenario-header">
        <div class="scenario-num">4</div>
        <div>
            <div class="scenario-title">Legacy Credentials (CLI)</div>
            <div class="scenario-subtitle">CLI Simulator — accesso a credenziali legacy criptate per sistemi non-OAuth2</div>
        </div>
    </div>
    <div class="scenario-body">

        <!-- TAB SELECTOR -->
        <div style="margin-bottom: 24px; display: flex; gap: 12px; border-bottom: 1px solid #30363d; padding-bottom: 16px;">
            <button class="tab-btn active" onclick="switchS4Tab('manager')">👨‍💼 4A - Manager (Save)</button>
            <button class="tab-btn" onclick="switchS4Tab('reader')">📖 4B - Reader (Get)</button>
        </div>

        <!-- SECTION 4A: MANAGER - SAVE CREDENTIALS -->
        <div id="s4a-manager" style="display: block;">
            <h3 style="margin-bottom: 16px; color: #e3b341;">Manager: Salva Credenziale Legacy</h3>

            <div class="form-row">
                <div class="form-group">
                    <label>Service ID</label>
                    <input id="s4a-service-id" type="text" value="cli-legacy" />
                </div>
                <div class="form-group">
                    <label>Username</label>
                    <input id="s4a-username" type="text" value="admin" />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input id="s4a-password" type="text" value="secret-cli-password" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Description</label>
                    <input id="s4a-desc" type="text" value="Legacy CLI system credentials" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group full">
                    <label>Allowed Client IDs (opzionale — lascia vuoto per permettere a tutti)</label>
                    <select id="s4a-allowed-clients" multiple style="height: 100px;">
                        <option value="cli-simulator">CLI Simulator</option>
                        <option value="erp-simulator">ERP Simulator</option>
                        <option value="crm-simulator">CRM Simulator</option>
                    </select>
                    <small style="display: block; margin-top: 8px; color: #8b949e;">💡 Ctrl+Click per selezionare più client, lascia vuoto per nessuna restrizione</small>
                </div>
            </div>

            <button class="btn btn-yellow" onclick="runScenario4aSave()" style="background:#3d2b00;border:1px solid #8b5a00;color:#e3b341;">💾 Salva Credenziale</button>
            <div class="loading" id="s4a-loading">⏳ Chiamata in corso...</div>

            <div class="response-area" id="s4a-response">
                <div class="response-tabs">
                    <button class="tab-btn active" onclick="switchTab('s4a','raw')">JSON risposta</button>
                </div>
                <div class="tab-content">
                    <div class="tab-panel active" id="s4a-tab-raw"></div>
                </div>
            </div>
        </div>

        <!-- SECTION 4B: READER - READ CREDENTIALS -->
        <div id="s4b-reader" style="display: none;">
            <h3 style="margin-bottom: 16px; color: #e3b341;">Reader: Leggi Credenziale Legacy</h3>

            <div class="form-row">
                <div class="form-group">
                    <label>Service ID</label>
                    <input id="s4b-service-id" type="text" value="cli-legacy" />
                </div>
                <div class="form-group">
                    <label>Client da usare</label>
                    <select id="s4b-client"></select>
                </div>
            </div>

            <button class="btn btn-yellow" onclick="runScenario4bGet()" style="background:#3d2b00;border:1px solid #8b5a00;color:#e3b341;">🔓 Leggi Password</button>
            <div class="loading" id="s4b-loading">⏳ Chiamata in corso...</div>

            <div class="response-area" id="s4b-response">
                <div class="response-tabs">
                    <button class="tab-btn active" onclick="switchTab('s4b','raw')">JSON risposta</button>
                    <button class="tab-btn" onclick="switchTab('s4b','decrypt')">Password Decriptata</button>
                </div>
                <div class="tab-content">
                    <div class="tab-panel active" id="s4b-tab-raw"></div>
                    <div class="tab-panel" id="s4b-tab-decrypt"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
const BASE_URL = '@ViewBag.BaseUrl';

// ── Carica client disponibili + secret ───────────────────────
let clientSecrets = {};

async function loadClients() {
    try {
        const [clientsRes, secretsRes] = await Promise.all([
            fetch(`${BASE_URL}/api/clients`),
            fetch(`${BASE_URL}/test/client-secrets`)
        ]);

        let clients;
        try {
            clients = await clientsRes.json();
        } catch(e) {
            const text = await clientsRes.text();
            console.error('Errore parsing API /clients response:', text);
            return;
        }

        try {
            clientSecrets = await secretsRes.json();
        } catch(e) {
            console.warn('Failed to load client secrets', e);
        }

        const fill = (id, grantType) => {
            const sel = document.getElementById(id);
            const filtered = clients.filter(c => c.grantTypes.includes(grantType));
            sel.innerHTML = filtered.map(c =>
                `<option value="${c.clientId}">${c.displayName || c.clientId}</option>`
            ).join('') || '<option value="">— nessun client disponibile —</option>';
        };

        fill('s1-client', 'password');
        fill('s2-client', 'authorization_code');
        fill('s3-client', 'client_credentials');

        // Auto-popola i secret quando cambia la selezione
        const autoFillSecret = (selectId, secretInputId) => {
            const sel = document.getElementById(selectId);
            const input = document.getElementById(secretInputId);
            const update = () => { input.value = clientSecrets[sel.value] ?? ''; };
            sel.addEventListener('change', update);
            update();
        };
        autoFillSecret('s2-client', 's2-secret');
        autoFillSecret('s3-client', 's3-secret');

    } catch (e) {
        console.warn('Failed to load clients', e);
    }
}
loadClients().then(() => initS2RefreshPanel());

// ── Mode badge ────────────────────────────────────────────────
async function checkMode() {
    const badge = document.getElementById('mode-badge');
    const label = document.getElementById('mode-label');
    try {
        const res = await fetch(`${BASE_URL}/test/mode`);
        const data = await res.json();
        badge.className = 'mode-badge ' + (data.online ? 'online' : 'offline');
        label.textContent = data.online
            ? 'ONLINE — Keycloak attivo'
            : 'OFFLINE — Modalità locale';
    } catch {
        badge.className = 'mode-badge checking';
        label.textContent = 'Impossibile verificare modalità';
    }
}
checkMode();
setInterval(checkMode, 6000);

async function startScenario2() {
    const clientId = document.getElementById('s2-client').value;
    const secret   = document.getElementById('s2-secret').value;

    // Salva le credenziali server-side e ottieni uno state token
    const res = await fetch(`${BASE_URL}/test/save-client-state`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ clientId, secret })
    });
    let stateData;
    try {
        stateData = await res.json();
    } catch(e) {
        const text = await res.text();
        console.error('Errore parsing /test/save-client-state response:', text);
        alert('Errore: ' + text);
        return;
    }
    const { state } = stateData;

    const redirect = encodeURIComponent(`${BASE_URL}/test/callback`);
    const url = `${BASE_URL}/connect/authorize?client_id=${clientId}&redirect_uri=${redirect}&response_type=code&scope=openid%20profile%20email%20offline_access&state=${encodeURIComponent(state)}`;
    window.location.href = url;
}

// ── Scenario 1 ───────────────────────────────────────────────
async function runScenario1() {
    const username  = document.getElementById('s1-username').value;
    const password  = document.getElementById('s1-password').value;
    const scope     = document.getElementById('s1-scope').value;
    const client_id = document.getElementById('s1-client').value;

    setFlow1Step('request');
    showLoading('s1', true);

    const params = new URLSearchParams({
        grant_type: 'password', username, password,
        client_id, scope
    });

    try {
        const res  = await fetch(`${BASE_URL}/connect/token`, { method: 'POST', body: params });
        let data;
        try {
            data = await res.json();
        } catch(e) {
            const text = await res.text();
            showLoading('s1', false);
            document.getElementById('s1-response').textContent = '❌ Errore parsing token response:\n' + text;
            document.getElementById('s1-response').classList.add('visible');
            return;
        }
        showLoading('s1', false);

        const hasRefresh = !!data.refresh_token;
        setFlow1Step(res.ok ? (hasRefresh ? 'done-refresh' : 'done') : 'error');

        displayResponse('s1-tab-raw', res.status, data);

        if (data.access_token) {
            document.getElementById('s1-tab-access').innerHTML = renderTokenDetail(data.access_token);
            document.getElementById('s1-api-content').innerHTML = renderApiCallBox('s1', data.access_token);
        }
        if (data.refresh_token) {
            document.getElementById('s1-tab-refresh').innerHTML = renderRefreshInfo(data.refresh_token);
        } else {
            document.getElementById('s1-tab-refresh').innerHTML =
                '<span style="color:#8b949e">Nessun refresh_token — aggiungi "offline_access" allo scope.</span>';
        }

        document.getElementById('s1-response').classList.add('visible');
    } catch(e) {
        showLoading('s1', false);
        document.getElementById('s1-tab-raw').textContent = 'Errore: ' + e.message;
        document.getElementById('s1-response').classList.add('visible');
    }
}

function setFlow1Step(state) {
    const steps = ['s1-step1','s1-step2','s1-step3','s1-step4'];
    steps.forEach(id => {
        document.getElementById(id).className = 'step';
    });
    if (state === 'request') {
        document.getElementById('s1-step1').classList.add('done');
        document.getElementById('s1-step2').classList.add('active');
    } else if (state === 'done') {
        document.getElementById('s1-step1').classList.add('done');
        document.getElementById('s1-step2').classList.add('done');
        document.getElementById('s1-step3').classList.add('done');
    } else if (state === 'done-refresh') {
        steps.forEach(id => document.getElementById(id).classList.add('done'));
    } else if (state === 'error') {
        document.getElementById('s1-step1').classList.add('done');
        document.getElementById('s1-step2').classList.add('active');
    }
}

// ── Scenario 3 ───────────────────────────────────────────────
async function runScenario3() {
    document.getElementById('s3-step1').className = 'step done';
    document.getElementById('s3-step2').className = 'step active';
    showLoading('s3', true);

    const params = new URLSearchParams({
        grant_type: 'client_credentials',
        client_id: document.getElementById('s3-client').value,
        client_secret: document.getElementById('s3-secret').value,
        scope: document.getElementById('s3-scope').value
    });

    try {
        const res  = await fetch(`${BASE_URL}/connect/token`, { method: 'POST', body: params });
        let data;
        try {
            data = await res.json();
        } catch(e) {
            const text = await res.text();
            showLoading('s3', false);
            document.getElementById('s3-tab-raw').textContent = '❌ Errore parsing token response:\n' + text;
            document.getElementById('s3-response').classList.add('visible');
            return;
        }
        showLoading('s3', false);

        document.getElementById('s3-step2').className = 'step done';
        document.getElementById('s3-step3').className = 'step done';

        displayResponse('s3-tab-raw', res.status, data);
        if (data.access_token) {
            document.getElementById('s3-tab-access').innerHTML = renderTokenDetail(data.access_token);
            document.getElementById('s3-api-content').innerHTML = renderApiCallBox('s3', data.access_token);
        }
        document.getElementById('s3-response').classList.add('visible');
    } catch(e) {
        showLoading('s3', false);
        document.getElementById('s3-tab-raw').textContent = 'Errore: ' + e.message;
        document.getElementById('s3-response').classList.add('visible');
    }
}

// ── Scenario 2: Refresh Token ─────────────────────────────────
function getRtKey() {
    return 's2-refresh-token-' + (document.getElementById('s2-client')?.value || 'default');
}

function initS2RefreshPanel() {
    // Auto-seleziona il client che ha un refresh token salvato
    const sel = document.getElementById('s2-client');
    if (sel) {
        for (const opt of sel.options) {
            if (opt.value && localStorage.getItem('s2-refresh-token-' + opt.value)) {
                sel.value = opt.value;
                break;
            }
        }
    }
    const rt = localStorage.getItem(getRtKey());
    document.getElementById('s2-refresh-panel').style.display = rt ? 'block' : 'none';
    document.getElementById('s2-no-token-msg').style.display  = rt ? 'none'  : 'block';
    if (rt) document.getElementById('s2-rt-preview').textContent = rt.substring(0, 50) + '...';
}

function clearRefreshToken() {
    localStorage.removeItem(getRtKey());
    document.getElementById('s2-refresh-panel').style.display = 'none';
    document.getElementById('s2-no-token-msg').style.display  = 'block';
}

async function runRefresh() {
    const rt = localStorage.getItem(getRtKey());
    if (!rt) return;

    const clientId     = document.getElementById('s2-client').value;
    const clientSecret = document.getElementById('s2-secret').value;

    showLoading('s2', true);
    try {
        const res  = await fetch('/test/refresh', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ refreshToken: rt, clientId, clientSecret })
        });
        let data;
        try {
            data = await res.json();
        } catch(e) {
            const text = await res.text();
            showLoading('s2', false);
            document.getElementById('s2-tab-raw').textContent = '❌ Errore parsing refresh response:\n' + text;
            return;
        }
        showLoading('s2', false);

        if (res.ok && data.refresh_token) {
            // rotation: aggiorna il token salvato
            localStorage.setItem(getRtKey(), data.refresh_token);
            document.getElementById('s2-rt-preview').textContent = data.refresh_token.substring(0, 50) + '...';
        }

        if (!res.ok || data.error) {
            localStorage.removeItem(getRtKey());
            document.getElementById('s2-refresh-panel').style.display = 'none';
            document.getElementById('s2-no-token-msg').style.display  = 'block';
            document.getElementById('s2-tab-raw').textContent =
                '❌ Refresh fallito — consent scaduto o token non valido.\n\nRiavvia il flow con "Avvia Authorization Code Flow".\n\n' +
                JSON.stringify(data, null, 2);
        } else {
            document.getElementById('s2-tab-raw').textContent = JSON.stringify(data, null, 2);
            if (data.access_token) {
                document.getElementById('s2-tab-access').innerHTML = renderTokenDetail(data.access_token);
                document.getElementById('s2-api-content').innerHTML = renderApiCallBox('s2', data.access_token);
            }
        }
        document.getElementById('s2-response').classList.add('visible');
    } catch(e) {
        showLoading('s2', false);
        document.getElementById('s2-tab-raw').textContent = 'Errore: ' + e.message;
        document.getElementById('s2-response').classList.add('visible');
    }
}

// initS2RefreshPanel viene chiamato dopo loadClients()

// ── Tab switching ─────────────────────────────────────────────
function switchTab(scenario, tab) {
    const container = document.getElementById(`${scenario}-response`);
    container.querySelectorAll('.tab-btn').forEach(btn => {
        const onclick = btn.getAttribute('onclick') || '';
        btn.classList.toggle('active', onclick.includes(`'${tab}'`));
    });
    container.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    const panel = document.getElementById(`${scenario}-tab-${tab}`);
    if (panel) panel.classList.add('active');
}

// ── JWT helpers ───────────────────────────────────────────────
function decodeJwt(token) {
    try {
        const b64 = token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/');
        return JSON.parse(atob(b64));
    } catch(e) { return null; }
}

function renderTokenDetail(token) {
    const payload = decodeJwt(token);
    if (!payload) return '<span style="color:#f85149">Token non decodificabile</span>';

    const now = Math.floor(Date.now() / 1000);
    const exp = payload.exp;
    const remaining = exp ? exp - now : null;
    const expClass  = remaining > 300 ? 'exp-ok' : 'exp-warn';
    const expLabel  = remaining > 0
        ? `Scade tra ${Math.floor(remaining/60)}m ${remaining%60}s`
        : 'Scaduto';

    let rows = '';
    for (const [k, v] of Object.entries(payload)) {
        let val = typeof v === 'object' ? JSON.stringify(v) : String(v);
        if (k === 'exp' || k === 'iat' || k === 'nbf') {
            val += `  <span style="color:#8b949e">(${new Date(v*1000).toLocaleString()})</span>`;
        }
        rows += `<tr><td>${k}</td><td>${val}</td></tr>`;
    }

    return `
        <table class="claims-table">
            <thead><tr><th>Claim</th><th>Valore</th></tr></thead>
            <tbody>${rows}</tbody>
        </table>
        ${exp ? `<div class="token-exp"><span class="${expClass}">⏱ ${expLabel}</span></div>` : ''}
    `;
}

function renderRefreshInfo(token) {
    return `
        <div style="font-size:13px; color:#8b949e; margin-bottom:12px;">
            Il refresh token è opaco (non è un JWT decodificabile). Viene conservato dal client e usato per rinnovare l'access token.
        </div>
        <div class="config-box" style="margin-bottom:0">
            <div class="config-item"><span class="config-key">grant_type</span><span class="config-val">refresh_token</span></div>
            <div class="config-item"><span class="config-key">client_id</span><span class="config-val">hmi-local</span></div>
            <div class="config-item"><span class="config-key">refresh_token</span><span class="config-val highlight" style="word-break:break-all">${token}</span></div>
        </div>
    `;
}

function showLoading(scenario, show) {
    document.getElementById(`${scenario}-loading`).classList.toggle('visible', show);
}

// Helper: Display HTTP response with status code and JSON
function displayResponse(elementId, status, data) {
    const statusText = {
        200: 'OK',
        201: 'Created',
        400: 'Bad Request',
        401: 'Unauthorized',
        403: 'Forbidden',
        404: 'Not Found',
        500: 'Internal Server Error'
    }[status] || 'Unknown';

    let statusColor, statusBg, statusIcon;
    if (status >= 200 && status < 300) {
        statusColor = '#238636';
        statusBg = '#0d3817';
        statusIcon = '✅';
    } else if (status >= 400 && status < 500) {
        statusColor = '#f85149';
        statusBg = '#3d1f1a';
        statusIcon = '⚠️';
    } else if (status >= 500) {
        statusColor = '#da3633';
        statusBg = '#490202';
        statusIcon = '❌';
    } else {
        statusColor = '#8b949e';
        statusBg = '#161b22';
        statusIcon = 'ℹ️';
    }

    const jsonStr = typeof data === 'string' ? data : JSON.stringify(data, null, 2);

    document.getElementById(elementId).innerHTML = `
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px; padding: 6px 10px; background: ${statusBg}; border: 1px solid ${statusColor}; border-radius: 4px; width: fit-content;">
            <span style="font-size: 14px;">${statusIcon}</span>
            <span style="color: ${statusColor}; font-weight: 600; font-family: 'Monaco', 'Courier New', monospace; font-size: 13px;">
                ${status} ${statusText}
            </span>
        </div>
        <pre style="background: #0d1117; color: #c9d1d9; padding: 12px; border-radius: 4px; overflow-x: auto; border: 1px solid #30363d; font-size: 12px; line-height: 1.5; margin: 0;">${jsonStr}</pre>
    `;
}

// ── SCENARIO 4: Legacy Credentials ────────────────────────────
function switchS4Tab(section) {
    // Hide both sections
    document.getElementById('s4a-manager').style.display = 'none';
    document.getElementById('s4b-reader').style.display = 'none';

    // Deactivate both buttons
    const btns = document.querySelectorAll('[onclick*="switchS4Tab"]');
    btns.forEach(b => b.classList.remove('active'));

    // Show selected section and activate button
    if (section === 'manager') {
        document.getElementById('s4a-manager').style.display = 'block';
        btns[0].classList.add('active');
    } else if (section === 'reader') {
        document.getElementById('s4b-reader').style.display = 'block';
        btns[1].classList.add('active');
        // Load available clients when entering reader section
        loadAvailableClientsForS4b();
    }
}

// Load available OAuth2 clients for section 4B reader
async function loadAvailableClientsForS4b() {
    const select = document.getElementById('s4b-client');

    // Default hardcoded list
    const defaultClients = [
        { clientId: "cli-simulator", displayName: "CLI Simulator", description: "Legge credenziali per servizi CLI" },
        { clientId: "erp-simulator", displayName: "ERP Simulator", description: "Legge credenziali per sistema ERP" },
        { clientId: "crm-simulator", displayName: "CRM Simulator", description: "Legge credenziali per sistema CRM" },
        { clientId: "unauthorized-test", displayName: "⚠️ Unauthorized Test", description: "NO legacy-password-reader role (test auth failure)" }
    ];

    try {
        const res = await fetch(`${BASE_URL}/api/legacy/available-clients`);

        if (res.ok) {
            let data;
            try {
                data = await res.json();
            } catch(e) {
                const text = await res.text();
                console.warn('Error parsing available clients response:', text);
                throw e; // Fall through to outer catch
            }
            if (data.clients && data.clients.length > 0) {
                select.innerHTML = data.clients.map(c =>
                    `<option value="${c.clientId}">${c.displayName || c.clientId}${c.description ? ' — ' + c.description : ''}</option>`
                ).join('');
                return;
            }
        }
    } catch(e) {
        console.warn('Error loading available clients from API, using hardcoded list', e);
    }

    // Fallback: use hardcoded list
    select.innerHTML = defaultClients.map(c =>
        `<option value="${c.clientId}">${c.displayName}${c.description ? ' — ' + c.description : ''}</option>`
    ).join('');
}

// 4A: Manager - Save Legacy Credential
async function runScenario4aSave() {
    showLoading('s4a', true);
    try {
        // 1. Get Client Credentials token for legacy-credentials-manager
        const params = new URLSearchParams({
            grant_type: 'client_credentials',
            client_id: 'legacy-credentials-manager',
            client_secret: 'legacy-manager-secret-456',
            scope: 'openid'
        });

        const tokenRes = await fetch(`${BASE_URL}/connect/token`, { method: 'POST', body: params });
        let tokenText = await tokenRes.text();
        let tokenData;
        try {
            tokenData = JSON.parse(tokenText);
        } catch(e) {
            document.getElementById('s4a-tab-raw').textContent = '❌ Errore parsing token response:\n' + tokenText;
            document.getElementById('s4a-response').classList.add('visible');
            showLoading('s4a', false);
            return;
        }

        if (!tokenRes.ok || !tokenData.access_token) {
            displayResponse('s4a-tab-raw', tokenRes.status, tokenData);
            document.getElementById('s4a-response').classList.add('visible');
            showLoading('s4a', false);
            return;
        }

        // 2. Save legacy credential with AllowedClientIds
        const serviceId = document.getElementById('s4a-service-id').value;
        const username = document.getElementById('s4a-username').value;
        const password = document.getElementById('s4a-password').value;
        const description = document.getElementById('s4a-desc').value;

        // Get selected values from multi-select dropdown
        const selectElement = document.getElementById('s4a-allowed-clients');
        const allowedClientIds = Array.from(selectElement.selectedOptions).map(opt => opt.value);

        const saveRes = await fetch(`${BASE_URL}/api/legacy/credentials`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${tokenData.access_token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                serviceId,
                username,
                password,
                description,
                allowedClientIds: allowedClientIds.length > 0 ? allowedClientIds : null
            })
        });

        let saveText = await saveRes.text();
        let saveData;
        try {
            saveData = JSON.parse(saveText);
        } catch(e) {
            displayResponse('s4a-tab-raw', saveRes.status, saveText);
            document.getElementById('s4a-response').classList.add('visible');
            showLoading('s4a', false);
            return;
        }

        showLoading('s4a', false);

        displayResponse('s4a-tab-raw', saveRes.status, saveData);
        document.getElementById('s4a-response').classList.add('visible');

        if (saveRes.ok) {
            // Store token for reader section
            localStorage.setItem('s4-manager-token', tokenData.access_token);
            localStorage.setItem('s4-last-saved-service', serviceId);
        }
    } catch(e) {
        showLoading('s4a', false);
        document.getElementById('s4a-tab-raw').textContent = '❌ Errore: ' + e.message;
        document.getElementById('s4a-response').classList.add('visible');
    }
}

// 4B: Reader - Get Legacy Credential
async function runScenario4bGet() {
    // Clear previous password display
    document.getElementById('s4b-tab-decrypt').innerHTML = '';

    showLoading('s4b', true);
    try {
        const clientId = document.getElementById('s4b-client').value;
        const serviceId = document.getElementById('s4b-service-id').value;

        if (!clientId) {
            document.getElementById('s4b-tab-raw').textContent = '❌ Errore: Seleziona un client';
            document.getElementById('s4b-response').classList.add('visible');
            showLoading('s4b', false);
            return;
        }

        if (!serviceId) {
            document.getElementById('s4b-tab-raw').textContent = '❌ Errore: Inserisci Service ID';
            document.getElementById('s4b-response').classList.add('visible');
            showLoading('s4b', false);
            return;
        }

        // Get token for selected client using Client Credentials
        const params = new URLSearchParams({
            grant_type: 'client_credentials',
            client_id: clientId,
            client_secret: getClientSecret(clientId),
            scope: 'openid'
        });

        const tokenRes = await fetch(`${BASE_URL}/connect/token`, { method: 'POST', body: params });
        let tokenText = await tokenRes.text();
        let tokenData;
        try {
            tokenData = JSON.parse(tokenText);
        } catch(e) {
            document.getElementById('s4b-tab-raw').textContent = '❌ Errore parsing token response:\n' + tokenText;
            document.getElementById('s4b-response').classList.add('visible');
            showLoading('s4b', false);
            return;
        }

        if (!tokenRes.ok || !tokenData.access_token) {
            displayResponse('s4b-tab-raw', tokenRes.status, tokenData);
            document.getElementById('s4b-response').classList.add('visible');
            showLoading('s4b', false);
            return;
        }

        // Get password using client token
        const res = await fetch(`${BASE_URL}/api/legacy/get-password`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${tokenData.access_token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ serviceId })
        });

        let text = await res.text();
        let data;
        try {
            data = JSON.parse(text);
        } catch(e) {
            displayResponse('s4b-tab-raw', res.status, text);
            console.error('Full response:', text);
            document.getElementById('s4b-response').classList.add('visible');
            showLoading('s4b', false);
            return;
        }

        showLoading('s4b', false);

        displayResponse('s4b-tab-raw', res.status, data);

        if (data.password) {
            document.getElementById('s4b-tab-decrypt').innerHTML = `
                <div style="background:#0d2818; border:1px solid #238636; border-radius:6px; padding:16px; margin-top:12px;">
                    <div style="font-size:11px; color:#56d364; text-transform:uppercase; letter-spacing:.5px; margin-bottom:8px">⚠️ Password Decriptata</div>
                    <div style="font-family:monospace; font-size:14px; color:#56d364; word-break:break-all; letter-spacing:1px;">
                        ${data.password}
                    </div>
                    <div style="font-size:11px; color:#8b949e; margin-top:12px;">
                        Questa password è stata decriptata dal database locale e rimane SOLO in memoria. Utilizzala immediatamente e scarta.
                    </div>
                </div>
            `;
        }

        document.getElementById('s4b-response').classList.add('visible');
    } catch(e) {
        showLoading('s4b', false);
        document.getElementById('s4b-tab-raw').textContent = '❌ Errore: ' + e.message;
        document.getElementById('s4b-response').classList.add('visible');
    }
}

// Helper: Get client secret by client ID (hardcoded for demo)
function getClientSecret(clientId) {
    const secrets = {
        'cli-simulator': 'cli-simulator-secret-789',
        'erp-simulator': 'erp-simulator-secret-789',
        'crm-simulator': 'crm-simulator-secret-789',
        'unauthorized-test': 'unauthorized-test-secret'
    };
    return secrets[clientId] || 'unknown-secret';
}

// Helper: Get auth token from storage
function getAuthToken() {
    return localStorage.getItem('auth-token') || '';
}

// ── API call ──────────────────────────────────────────────────
function renderApiCallBox(scenario, token) {
    return `
        <div class="api-call-box">
            <div class="api-url">
                <span class="method">GET</span>
                <span class="path">${BASE_URL}/api/me</span>
                <span class="auth-badge">Authorization: Bearer</span>
            </div>
            <button class="btn btn-blue" style="font-size:13px; padding:8px 16px"
                    onclick="callApi('${scenario}', '${token}')">
                ▶ Esegui chiamata API protetta
            </button>
            <div id="${scenario}-api-result" class="api-result"></div>
        </div>`;
}

async function callApi(scenario, token) {
    const resultEl = document.getElementById(`${scenario}-api-result`);
    resultEl.innerHTML = '<span style="color:#8b949e; font-size:13px">⏳ Chiamata in corso...</span>';

    try {
        const res = await fetch(`${BASE_URL}/api/me`, {
            headers: { 'Authorization': `Bearer ${token}` }
        });

        const statusClass = res.ok ? 'http-200' : 'http-401';
        const statusLabel = res.ok ? '✅ 200 OK — Token valido' : `❌ ${res.status} — Token non valido`;

        let body;
        try { body = await res.json(); } catch { body = { error: 'risposta non JSON' }; }

        let claimsHtml = '';
        if (res.ok && body.claims) {
            const rows = body.claims.map(c =>
                `<tr><td>${c.type}</td><td>${c.value}</td></tr>`
            ).join('');
            claimsHtml = `
                <div style="margin-top:14px">
                    <div style="font-size:11px; color:#8b949e; text-transform:uppercase; letter-spacing:.5px; margin-bottom:6px">Claims visti dal server</div>
                    <table class="claims-table">
                        <thead><tr><th>Tipo</th><th>Valore</th></tr></thead>
                        <tbody>${rows}</tbody>
                    </table>
                </div>`;
        }

        resultEl.innerHTML = `
            <div class="api-result-header">
                <span class="http-status ${statusClass}">${statusLabel}</span>
            </div>
            <div style="font-family:monospace; font-size:12px; color:#8b949e; background:#0d1117; border:1px solid #30363d; border-radius:6px; padding:12px; white-space:pre-wrap">${JSON.stringify(body, null, 2)}</div>
            ${claimsHtml}`;

    } catch(e) {
        resultEl.innerHTML = `<span style="color:#f85149">Errore: ${e.message}</span>`;
    }
}
</script>
</body>
