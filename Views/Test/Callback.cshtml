<!DOCTYPE html>
<html>
<head>
    <title>OAuth2 Callback — Scenario 2</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
            background: #0f1117; color: #e1e4e8;
            min-height: 100vh; padding: 32px 16px;
        }
        .container { max-width: 820px; margin: 0 auto; }
        .back { color: #8b949e; font-size: 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 28px; }
        .back:hover { color: #e1e4e8; }

        .card { background: #161b22; border: 1px solid #30363d; border-radius: 12px; margin-bottom: 20px; overflow: hidden; }
        .card-header { padding: 16px 20px; border-bottom: 1px solid #30363d; display: flex; align-items: center; gap: 10px; }
        .card-title { font-size: 15px; font-weight: 600; color: #fff; }
        .card-body { padding: 20px; }

        .step-badge { background: #1f4d8a; color: #58a6ff; border-radius: 50%; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; flex-shrink: 0; }
        .step-badge.done { background: #0d2818; color: #56d364; }
        .step-badge.err { background: #3d0e0e; color: #f85149; }

        .kv { display: flex; gap: 10px; margin-bottom: 8px; font-size: 13px; }
        .kv-key { color: #8b949e; min-width: 110px; flex-shrink: 0; }
        .kv-val { color: #e1e4e8; font-family: monospace; word-break: break-all; }
        .kv-val.ok { color: #56d364; }
        .kv-val.err { color: #f85149; }
        .kv-val.hl { color: #e3b341; }

        pre { background: #0d1117; border: 1px solid #30363d; border-radius: 6px; padding: 14px; font-size: 12px; font-family: monospace; white-space: pre-wrap; word-break: break-all; color: #e1e4e8; max-height: 300px; overflow-y: auto; }

        .claims-table { width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 12px; }
        .claims-table th { text-align: left; padding: 6px 10px; color: #8b949e; border-bottom: 1px solid #21262d; font-weight: 500; }
        .claims-table td { padding: 6px 10px; border-bottom: 1px solid #161b22; }
        .claims-table td:first-child { color: #58a6ff; font-family: monospace; white-space: nowrap; }
        .claims-table td:last-child { color: #e1e4e8; font-family: monospace; word-break: break-all; }

        .btn { padding: 9px 18px; border: none; border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.15s; text-decoration: none; display: inline-block; }
        .btn-blue { background: #1f6feb; color: #fff; }
        .btn-blue:hover { background: #388bfd; }
        .btn-gray { background: #21262d; border: 1px solid #30363d; color: #e1e4e8; }
        .btn-gray:hover { background: #30363d; }

        .http-status { display: inline-block; padding: 3px 10px; border-radius: 4px; font-size: 12px; font-weight: 700; margin-bottom: 10px; }
        .http-200 { background: #0d2818; color: #56d364; border: 1px solid #238636; }
        .http-401 { background: #3d0e0e; color: #f85149; border: 1px solid #da3633; }

        .api-url { display: inline-flex; align-items: center; gap: 8px; background: #21262d; border: 1px solid #30363d; border-radius: 6px; padding: 8px 14px; font-family: monospace; font-size: 13px; color: #8b949e; margin-bottom: 14px; }
        .api-url .method { color: #56d364; font-weight: 700; }
        .api-url .path { color: #58a6ff; }
        .api-url .auth-badge { background: #0d1f3c; color: #58a6ff; border: 1px solid #388bfd; border-radius: 4px; padding: 2px 7px; font-size: 11px; }
    </style>
</head>
<body>
<div class="container">

    <a href="/test" class="back">← Torna al Test Client</a>

    @if (ViewBag.Error != null)
    {
        <div class="card">
            <div class="card-header">
                <div class="step-badge err">!</div>
                <div class="card-title">Errore nel flow</div>
            </div>
            <div class="card-body">
                <div class="kv"><span class="kv-key">error</span><span class="kv-val err">@ViewBag.Error</span></div>
                @if (ViewBag.ErrorDescription != null)
                {
                    <div class="kv"><span class="kv-key">description</span><span class="kv-val">@ViewBag.ErrorDescription</span></div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- Step 1: Code ricevuto -->
        <div class="card">
            <div class="card-header">
                <div class="step-badge done">1</div>
                <div class="card-title">Authorization Code ricevuto</div>
            </div>
            <div class="card-body">
                <div class="kv"><span class="kv-key">code</span><span class="kv-val hl" style="font-size:12px">@ViewBag.Code</span></div>
                <div class="kv" style="margin-top:4px"><span class="kv-key">stato</span><span class="kv-val ok">✅ Ricevuto da /connect/authorize</span></div>
            </div>
        </div>

        <!-- Step 2: Token Exchange -->
        <div class="card">
            <div class="card-header">
                <div class="step-badge done">2</div>
                <div class="card-title">Token Exchange — POST /connect/token</div>
            </div>
            <div class="card-body">
                @{
                    var tokenJson = ViewBag.TokenJson as string ?? "{}";
                    var tokenOk = ViewBag.TokenStatus is int s && s == 200;
                }

                @if (tokenOk)
                {
                    <div class="kv"><span class="kv-key">stato</span><span class="kv-val ok">✅ @ViewBag.TokenStatus OK</span></div>
                }
                else
                {
                    <div class="kv"><span class="kv-key">stato</span><span class="kv-val err">❌ @ViewBag.TokenStatus</span></div>
                }

                <div style="margin-top: 12px; font-size: 11px; color: #8b949e; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 6px;">Risposta</div>
                <pre>@tokenJson</pre>

                @if (tokenOk)
                {
                    <div style="margin-top:14px; font-size:11px; color:#8b949e; text-transform:uppercase; letter-spacing:.5px; margin-bottom:8px;">Payload Access Token</div>
                    <div id="jwt-decoded" style="color:#8b949e; font-size:13px">Caricamento...</div>
                }
            </div>
        </div>

        <!-- Step 3: Chiama API protetta -->
        @if (tokenOk)
        {
            <div class="card">
                <div class="card-header">
                    <div class="step-badge" id="api-step-badge">3</div>
                    <div class="card-title">Valida Token — Chiama API Protetta</div>
                </div>
                <div class="card-body">
                    <div class="api-url">
                        <span class="method">GET</span>
                        <span class="path">/api/me</span>
                        <span class="auth-badge">Authorization: Bearer</span>
                    </div>
                    <br/>
                    <button class="btn btn-blue" onclick="callApi()">▶ Esegui chiamata API protetta</button>
                    <div id="api-result" style="margin-top:16px"></div>
                </div>
            </div>
        }
    }

    <div style="margin-top: 8px;">
        <a href="/test" class="btn btn-gray">← Torna al Test Client</a>
    </div>
</div>

@if (ViewBag.TokenJson != null && ViewBag.TokenStatus != null && (int)ViewBag.TokenStatus == 200)
{
    <script>
        const tokenData = @Html.Raw(ViewBag.TokenJson);
        const accessToken = tokenData.access_token;

        // Decodifica JWT
        function decodeJwt(token) {
            try {
                const b64 = token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/');
                return JSON.parse(atob(b64));
            } catch(e) { return null; }
        }

        const payload = decodeJwt(accessToken);
        if (payload) {
            const rows = Object.entries(payload).map(([k, v]) => {
                let val = typeof v === 'object' ? JSON.stringify(v) : String(v);
                if (k === 'exp' || k === 'iat') val += `  <span style="color:#8b949e">(${new Date(v*1000).toLocaleString()})</span>`;
                return `<tr><td>${k}</td><td>${val}</td></tr>`;
            }).join('');

            document.getElementById('jwt-decoded').innerHTML = `
                <table class="claims-table">
                    <thead><tr><th>Claim</th><th>Valore</th></tr></thead>
                    <tbody>${rows}</tbody>
                </table>`;
        }

        // Chiama API protetta
        async function callApi() {
            const resultEl = document.getElementById('api-result');
            resultEl.innerHTML = '<span style="color:#8b949e; font-size:13px">⏳ Chiamata in corso...</span>';

            try {
                const res = await fetch('/api/me', {
                    headers: { 'Authorization': `Bearer ${accessToken}` }
                });

                const body = await res.json();
                const ok = res.ok;

                document.getElementById('api-step-badge').className = `step-badge ${ok ? 'done' : 'err'}`;

                let claimsHtml = '';
                if (ok && body.claims) {
                    const rows = body.claims.map(c =>
                        `<tr><td>${c.type}</td><td>${c.value}</td></tr>`
                    ).join('');
                    claimsHtml = `
                        <div style="margin-top:16px">
                            <div style="font-size:11px; color:#8b949e; text-transform:uppercase; letter-spacing:.5px; margin-bottom:6px">Claims visti dal server dopo validazione</div>
                            <table class="claims-table">
                                <thead><tr><th>Tipo</th><th>Valore</th></tr></thead>
                                <tbody>${rows}</tbody>
                            </table>
                        </div>`;
                }

                resultEl.innerHTML = `
                    <div class="http-status ${ok ? 'http-200' : 'http-401'}">${ok ? '✅ 200 OK — Token valido' : `❌ ${res.status} — Token non valido`}</div>
                    <pre>${JSON.stringify(body, null, 2)}</pre>
                    ${claimsHtml}`;

            } catch(e) {
                resultEl.innerHTML = `<span style="color:#f85149">Errore: ${e.message}</span>`;
            }
        }
    </script>
}
</body>
</html>
